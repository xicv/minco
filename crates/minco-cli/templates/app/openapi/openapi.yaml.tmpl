openapi: 3.1.0
info:
  title: {{TITLE}} API
  version: 0.1.0
  description: Contract-first API generated by Minco.
servers:
  - url: /
paths:
  /health/live:
    get:
      operationId: healthLive
      summary: Confirm that the process is alive
      security: []
      responses:
        '200':
          description: Process is alive
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/HealthResponse'
        default:
          $ref: '#/components/responses/Problem'
  /platform:
    get:
      operationId: getPlatform
      summary: Read public platform metadata
      security: []
      responses:
        '200':
          description: Platform metadata
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PlatformInfo'
        default:
          $ref: '#/components/responses/Problem'
components:
  responses:
    Problem:
      description: Machine-readable failure
      content:
        application/problem+json:
          schema:
            $ref: '#/components/schemas/ProblemDetails'
  schemas:
    HealthResponse:
      type: object
      additionalProperties: false
      required: [ok, service, version]
      properties:
        ok:
          type: boolean
        service:
          type: string
        version:
          type: string
    PlatformInfo:
      type: object
      additionalProperties: false
      required: [name, version]
      properties:
        name:
          type: string
        version:
          type: string
    ProblemDetails:
      type: object
      additionalProperties: false
      required: [type, title, status, detail, code, requestId]
      properties:
        type:
          type: string
          format: uri
        title:
          type: string
        status:
          type: integer
          format: int32
        detail:
          type: string
        code:
          type: string
        requestId:
          type: string
