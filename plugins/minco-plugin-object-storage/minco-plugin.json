{
  "schema": 1,
  "id": "object-storage",
  "kind": "plugin",
  "plugin_version": "1.0.0",
  "core_compatibility": "^0.5.0",
  "stability": "beta",
  "default_enabled": false,
  "feature": "plugin-object-storage",
  "runtimes": ["native"],
  "provides": [{ "name": "storage.object", "version": "1.0.0" }],
  "data_classes": ["customer_provided", "confidential"],
  "retention": "application_defined",
  "failure_policy": {
    "mode": "fail_closed",
    "description": "Failed object reads, writes, and deletes remain explicit storage errors."
  },
  "documentation": { "reference": "https://docs.rs/minco-plugin-object-storage" },
  "conformance": {
    "profile": "minco-plugin-v1",
    "evidence": ["cargo test -p minco-plugin-object-storage --all-features --locked"]
  }
}
