{
  "schema": 1,
  "id": "audit",
  "kind": "plugin",
  "plugin_version": "1.0.0",
  "core_compatibility": "^1.5.0",
  "stability": "beta",
  "default_enabled": false,
  "feature": "plugin-audit",
  "runtimes": ["native"],
  "provides": [
    { "name": "audit.append", "version": "1.0.0" },
    { "name": "audit.ledger", "version": "2.0.0" },
    { "name": "audit.query", "version": "2.0.0" },
    { "name": "audit.health", "version": "1.0.0" }
  ],
  "data_classes": ["internal", "personal", "confidential"],
  "retention": "persistent",
  "failure_policy": {
    "mode": "fail_closed",
    "description": "Audit validation, append, ID conflicts and hard lifecycle limits fail closed; records are never silently discarded."
  },
  "documentation": { "reference": "https://docs.rs/minco-plugin-audit" },
  "conformance": {
    "profile": "minco-plugin-v1",
    "evidence": ["cargo test -p minco-plugin-audit --all-features --locked"]
  }
}
