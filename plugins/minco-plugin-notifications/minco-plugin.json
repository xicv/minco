{
  "schema": 1,
  "id": "notifications",
  "kind": "plugin",
  "plugin_version": "1.0.0",
  "core_compatibility": "^1.2.1",
  "stability": "beta",
  "default_enabled": false,
  "feature": "plugin-notifications",
  "runtimes": ["native"],
  "provides": [
    { "name": "notifications.send", "version": "1.0.0" }
  ],
  "data_classes": ["personal", "confidential"],
  "retention": "application_defined",
  "failure_policy": {
    "mode": "fail_closed",
    "description": "Delivery failures are returned to the caller; ambiguous mail outcomes stop retries and failover instead of being reported as successful."
  },
  "documentation": { "reference": "https://docs.rs/minco-plugin-notifications" },
  "conformance": {
    "profile": "minco-plugin-v1",
    "evidence": ["cargo test -p minco-plugin-notifications --all-features --locked"]
  }
}
