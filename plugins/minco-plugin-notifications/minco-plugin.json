{
  "schema": 1,
  "id": "notifications",
  "kind": "plugin",
  "plugin_version": "1.0.0",
  "core_compatibility": "^1.1.0",
  "stability": "beta",
  "default_enabled": false,
  "feature": "plugin-notifications",
  "runtimes": ["native"],
  "provides": [
    { "name": "notifications.send", "version": "1.0.0" },
    { "name": "mail.send", "version": "1.0.0" }
  ],
  "data_classes": ["personal", "confidential"],
  "retention": "application_defined",
  "failure_policy": {
    "mode": "fail_closed",
    "description": "Invalid, rejected, and ambiguous delivery outcomes are returned to the caller. Failover occurs only after an explicitly retry-safe failure."
  },
  "documentation": { "reference": "https://docs.rs/minco-plugin-notifications" },
  "conformance": {
    "profile": "minco-plugin-v1",
    "evidence": ["cargo test -p minco-plugin-notifications --locked"]
  }
}
