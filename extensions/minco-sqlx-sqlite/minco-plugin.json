{
  "schema": 1,
  "id": "sqlx-sqlite",
  "kind": "adapter",
  "plugin_version": "0.7.0",
  "core_compatibility": "^1.11.0",
  "stability": "beta",
  "default_enabled": false,
  "feature": "sqlx-sqlite",
  "runtimes": ["native", "aws-lambda"],
  "databases": ["sqlite"],
  "provides": [
    { "name": "audit.append", "version": "1.0.0" },
    { "name": "idempotency.store", "version": "1.0.0" },
    { "name": "sessions.store", "version": "1.0.0" }
  ],
  "configuration": [
    { "key": "url", "kind": "string", "required": true, "secret": true, "description": "SQLite connection URL or file location supplied by the application" },
    { "key": "max_connections", "kind": "integer", "required": false, "secret": false, "description": "Bounded maximum pool size; in-memory databases require one", "default": 4 },
    { "key": "acquire_timeout_seconds", "kind": "integer", "required": false, "secret": false, "description": "Connection acquisition and busy timeout", "default": 5 }
  ],
  "migrations": [{ "id": "plugin-storage-sqlite-v1", "database": "sqlite", "path": "migrations/plugins" }],
  "resources": [{
    "id": "sqlite-database",
    "kind": "sqlite",
    "idle_cost": "storage_only"
  }],
  "health_checks": [{ "id": "sqlite-ready", "critical": true }],
  "data_classes": ["customer_provided", "personal", "confidential", "secret"],
  "retention": "application_defined",
  "failure_policy": {
    "mode": "fail_closed",
    "description": "Connection, transaction, migration, and verification failures are returned and never marked successful."
  },
  "documentation": { "reference": "https://docs.rs/minco-sqlx-sqlite" },
  "conformance": {
    "profile": "minco-adapter-v1",
    "evidence": ["cargo test -p minco-sqlx-sqlite --all-features --locked"]
  }
}
