APP_ENV=local
API_HOST=127.0.0.1
API_PORT=3000
DATABASE_KIND=sqlite
SQLITE_PATH=target/minco/orders.db
DATABASE_MAX_CONNECTIONS=2
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ALLOW_DEVELOPMENT_HEADERS=true
RUST_LOG=info,tower_http=info,sqlx=warn
MINCO_CONTAINER_RUNTIME=auto

# PostgreSQL local profile:
# DATABASE_KIND=postgres
# DATABASE_URL=postgres://minco:minco@127.0.0.1:55432/minco_orders
# MIGRATION_DATABASE_URL=postgres://minco:minco@127.0.0.1:55432/minco_orders

# Lambda profile loads the runtime URL from SSM instead of a plain environment variable:
# DATABASE_URL_PARAMETER=/minco/dev/orders/database-url
