{
  "allowed_headers": [
    "authorization",
    "content-type",
    "idempotency-key",
    "if-match",
    "if-none-match",
    "x-request-id"
  ],
  "allowed_origins": [
    "https://app.example.invalid"
  ],
  "application": "minco-orders",
  "application_graph": {
    "capabilities": {
      "audit.append": "1.0.0",
      "audit.health": "1.0.0",
      "audit.ledger": "2.0.0",
      "audit.query": "2.0.0",
      "health.registry": "1.0.0",
      "http.idempotency": "1.0.0",
      "idempotency.claim": "1.0.0",
      "idempotency.store": "1.0.0",
      "observability.tracing": "1.0.0"
    },
    "health_checks": {
      "minco-core": {
        "critical": true,
        "id": "minco-core"
      }
    },
    "migrations": {},
    "operations": {},
    "plugins": [
      {
        "configuration": [],
        "configuration_namespace": "plugins.audit",
        "core_compatibility": "^1.10.0",
        "data_classes": [
          "internal",
          "personal",
          "confidential"
        ],
        "default_enabled": false,
        "description": "Durable append-only audit history independent of operational logs",
        "documentation": "https://docs.rs/minco-plugin-audit",
        "health_checks": [],
        "id": "audit",
        "migrations": [],
        "operations": [],
        "plugin_dependencies": [],
        "provides": [
          {
            "name": "audit.append",
            "version": "1.0.0"
          },
          {
            "name": "audit.ledger",
            "version": "2.0.0"
          },
          {
            "name": "audit.query",
            "version": "2.0.0"
          },
          {
            "name": "audit.health",
            "version": "1.0.0"
          }
        ],
        "requires": [],
        "resources": [],
        "stability": "beta",
        "version": "1.0.0"
      },
      {
        "configuration": [],
        "configuration_namespace": "plugins.health",
        "core_compatibility": "^1.10.0",
        "data_classes": [],
        "default_enabled": true,
        "description": "Liveness, readiness, and dependency health registry",
        "documentation": "https://docs.rs/minco-plugin-health",
        "health_checks": [
          {
            "critical": true,
            "id": "minco-core"
          }
        ],
        "id": "health",
        "migrations": [],
        "operations": [],
        "plugin_dependencies": [],
        "provides": [
          {
            "name": "health.registry",
            "version": "1.0.0"
          }
        ],
        "requires": [],
        "resources": [],
        "stability": "stable",
        "version": "1.0.0"
      },
      {
        "configuration": [
          {
            "default": 300,
            "description": "Time after which an abandoned in-progress claim may be recovered",
            "key": "claim_timeout_seconds",
            "kind": "integer",
            "required": false,
            "secret": false
          }
        ],
        "configuration_namespace": "plugins.idempotency",
        "core_compatibility": "^1.10.0",
        "data_classes": [
          "internal"
        ],
        "default_enabled": true,
        "description": "Atomic idempotency claims, conflict detection, replay, and storage port",
        "documentation": "https://docs.rs/minco-plugin-idempotency",
        "health_checks": [],
        "id": "idempotency",
        "migrations": [],
        "operations": [],
        "plugin_dependencies": [],
        "provides": [
          {
            "name": "http.idempotency",
            "version": "1.0.0"
          },
          {
            "name": "idempotency.store",
            "version": "1.0.0"
          },
          {
            "name": "idempotency.claim",
            "version": "1.0.0"
          }
        ],
        "requires": [],
        "resources": [],
        "stability": "stable",
        "version": "1.0.0"
      },
      {
        "configuration": [
          {
            "default": "minco-app",
            "description": "Stable service name included in operational telemetry",
            "key": "service_name",
            "kind": "string",
            "required": false,
            "secret": false
          },
          {
            "default": true,
            "description": "Emit structured JSON suitable for CloudWatch Logs",
            "key": "json",
            "kind": "boolean",
            "required": false,
            "secret": false
          },
          {
            "default": "info,tower_http=info",
            "description": "Fallback tracing filter when RUST_LOG is unset",
            "key": "default_filter",
            "kind": "string",
            "required": false,
            "secret": false
          }
        ],
        "configuration_namespace": "plugins.observability",
        "core_compatibility": "^1.10.0",
        "data_classes": [],
        "default_enabled": true,
        "description": "Structured tracing and CloudWatch-compatible JSON logging",
        "documentation": "https://docs.rs/minco-plugin-observability",
        "health_checks": [],
        "id": "observability",
        "migrations": [],
        "operations": [],
        "plugin_dependencies": [],
        "provides": [
          {
            "name": "observability.tracing",
            "version": "1.0.0"
          }
        ],
        "requires": [],
        "resources": [],
        "stability": "stable",
        "version": "1.0.0"
      }
    ],
    "resources": {}
  },
  "auth": {
    "audiences": [
      "minco-orders"
    ],
    "issuer": "https://issuer.example.invalid",
    "kind": "jwt"
  },
  "cost_policy": {
    "deny_fixed_compute": true,
    "deny_nat_gateway": true,
    "deny_provisioned_concurrency": true,
    "deny_scheduled_wakeups": true,
    "max_database_connections": 20,
    "max_reserved_concurrency": 5
  },
  "database": {
    "compute_unit_hours": 20.0,
    "history_storage_gb_month": 0.0,
    "kind": "neon_postgres",
    "plan": "free",
    "storage_gb_month": 0.25
  },
  "environment": "dev",
  "exposed_headers": [
    "deprecation",
    "etag",
    "link",
    "location",
    "retry-after",
    "sunset",
    "www-authenticate",
    "x-request-id"
  ],
  "functions": [
    {
      "artifact_path": "target/lambda/orders-lambda/bootstrap.zip",
      "database_connections_per_instance": 2,
      "memory_mb": 512,
      "name": "api",
      "provisioned_concurrency": 0,
      "reserved_concurrency": 2,
      "timeout_seconds": 15
    }
  ],
  "ingress": "api_gateway_http_api",
  "local_aws_services": [
    "ssm",
    "sts"
  ],
  "log_retention_days": 14,
  "performance_policy": {
    "max_lambda_memory_mb": 1024,
    "max_lambda_timeout_seconds": 30,
    "max_request_body_bytes": 1048576,
    "target_artifact_bytes": 26214400
  },
  "region": "ap-southeast-2",
  "routes": [
    {
      "authenticated": true,
      "method": "delete",
      "operation_id": "deleteOrder",
      "path": "/orders/{orderId}"
    },
    {
      "authenticated": false,
      "method": "get",
      "operation_id": "getLive",
      "path": "/health/live"
    },
    {
      "authenticated": true,
      "method": "get",
      "operation_id": "getOrder",
      "path": "/orders/{orderId}"
    },
    {
      "authenticated": false,
      "method": "get",
      "operation_id": "getReady",
      "path": "/health/ready"
    },
    {
      "authenticated": true,
      "method": "get",
      "operation_id": "listOrderAuditHistory",
      "path": "/orders/{orderId}/audit"
    },
    {
      "authenticated": true,
      "method": "get",
      "operation_id": "listOrders",
      "path": "/orders"
    },
    {
      "authenticated": true,
      "method": "post",
      "operation_id": "placeOrder",
      "path": "/orders"
    },
    {
      "authenticated": true,
      "method": "patch",
      "operation_id": "updateOrder",
      "path": "/orders/{orderId}"
    }
  ],
  "runtime": "lambda_zip_arm64",
  "scheduled_wakeups": [],
  "schema_version": 1,
  "uses_nat_gateway": false
}
